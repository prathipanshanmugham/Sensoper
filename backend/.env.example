# Copy to backend/.env and fill in. Never commit the real .env.

# MongoDB (Atlas connection string) and database name
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sensoper

# Long random string — keep it stable, changing it signs everyone out.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Encrypts the Company logins vault. Generate once and keep it safe — losing it makes stored passwords unreadable.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# Only the site that serves the frontend may call the API with cookies (comma-separated if more than one)
CORS_ORIGINS=https://quote.sensoper.in

# Where uploaded files (site photos, asset documents) are stored on the server
STORAGE_ROOT=/root/Sensoper/storage

# First admin account — only used when that user doesn't exist yet. Change the password after first sign-in.
ADMIN_EMAIL=admin@sensoper.com
ADMIN_PASSWORD=
# Recovery only: set to true for ONE restart to reset the admin password to ADMIN_PASSWORD, then remove it.
# RESET_ADMIN_PASSWORD=true

# auto (default) = Secure cookies whenever the site is reached over HTTPS; true = always; false = never
COOKIE_SECURE=auto

# What3words — "Use my location" on New project fills in the 3-word address. Key from https://developer.what3words.com
# (restrict it to your domain there). The browser never sees it.
W3W_API_KEY=

# Google Drive — site photos are copied into the company Drive (Settings → Google Drive → Connect).
# OAuth client (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=712570910460-423uajd5qq8jr73dl0rmtqiv667img00.apps.googleusercontent.com
# The client's secret. Never commit it.
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that client exactly, and must open THIS app's /auth/google/callback page
GOOGLE_REDIRECT_URI=https://sensoper.in/auth/google/callback
# DISABLE_DRIVE_SYNC_LOOP=true   # stops the 10-minute background retry (photos still copy right after each save)

# Optional: electricity bill lookup provider
# BILL_FETCH_PROVIDER=
# BILL_FETCH_API_KEY=
